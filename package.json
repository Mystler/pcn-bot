{
  "name": "prismatic-carrier-network",
  "type": "module",
  "version": "1.1.0",
  "description": "Discord Bot to announce Fleet Carrier updates via EDDN data",
  "main": "dist/bot.js",
  "scripts": {
    "start": "node --enable-source-maps .",
    "register": "node --enable-source-maps dist/register.js",
    "build": "tsc",
    "clean": "rm -r dist",
    "lint": "prettier --check src && eslint src",
    "format": "prettier --write src"
  },
  "author": "Mystler",
  "dependencies": {
    "discord.js": "^14.27.0",
    "handlebars": "^4.7.9",
    "zeromq": "^6.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
